---
interface Props {
  asset: string;
  title: string;
  width: number;
  height: number;
  enabled?: boolean;
}
const { asset, title, width, height, enabled = false } = Astro.props;
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const media = `${base}/assets/videos/${asset}`;
---

<living-scene>
  <figure>
    <div class="scene-frame" style={`aspect-ratio:${width}/${height}`}>
      <img src={`${media}.webp`} alt={title} width={width} height={height} loading="lazy" decoding="async" />
      {enabled && <video hidden data-src={`${media}.mp4`} poster={`${media}.webp`} width={width} height={height} controls playsinline muted preload="none" aria-label={title}>
        <a href={`${media}.mp4`}>Abrir vídeo: {title}</a>
      </video>}
    </div>
    <figcaption>
      <h3>{title}</h3>
      {enabled && <button type="button" hidden>Reproduzir cena</button>}
      {enabled && <noscript><a href={`${media}.mp4`}>Abrir vídeo</a></noscript>}
      <p role="status" aria-live="polite"></p>
    </figcaption>
  </figure>
</living-scene>

<script>
  class LivingScene extends HTMLElement {
    cleanup?: () => void;
    connectedCallback() {
      this.cleanup?.();
      const video = this.querySelector('video');
      if (!video) return;
      const still = this.querySelector('img')!;
      const button = this.querySelector('button')!;
      const status = this.querySelector('[role="status"]')!;
      const abort = new AbortController();
      const options = { signal: abort.signal };
      button.hidden = false;
      const pause = () => video.pause();
      const fallback = () => {
        pause();
        video.hidden = true;
        still.hidden = false;
        button.hidden = false;
        status.textContent = 'Não foi possível reproduzir. A imagem permanece disponível.';
      };
      button.addEventListener('click', async () => {
        status.textContent = '';
        if (!video.getAttribute('src')) video.src = video.dataset.src!;
        video.hidden = false;
        still.hidden = true;
        button.hidden = true;
        try { await video.play(); } catch { fallback(); }
      }, options);
      video.addEventListener('error', fallback, options);
      video.addEventListener('play', () => {
        document.querySelectorAll<HTMLVideoElement>('living-scene video').forEach(other => {
          if (other !== video) other.pause();
        });
      }, options);
      document.addEventListener('visibilitychange', () => { if (document.hidden) pause(); }, options);
      document.addEventListener('astro:before-swap', pause, options);
      window.addEventListener('pagehide', pause, options);
      // No automatic play: reduced-motion and data-saving visitors keep the still image.
      const observer = new IntersectionObserver(entries => {
        if (!entries[0].isIntersecting) pause();
      });
      observer.observe(this);
      this.cleanup = () => { pause(); observer.disconnect(); abort.abort(); };
    }
    disconnectedCallback() { this.cleanup?.(); }
  }
  if (!customElements.get('living-scene')) customElements.define('living-scene', LivingScene);
</script>

<style>
  living-scene { display: block; min-width: 0; margin-block: 1.5rem; }
  figure { margin: 0; border: 1px solid var(--edge); background: var(--codex); }
  .scene-frame { position: relative; background: #0c0a08; }
  img, video { display: block; width: 100%; height: 100%; object-fit: contain; }
  [hidden] { display: none !important; }
  figcaption { padding: 1rem; }
  h3 { margin: 0 0 .8rem; color: var(--parchment); }
  button, a { color: var(--parchment); font: inherit; }
  button { border: 1px solid var(--edge); background: #211b15; padding: .7rem 1rem; cursor: pointer; min-height: 44px; }
  button:focus-visible, a:focus-visible, video:focus-visible { outline: 2px solid #d6b77a; outline-offset: 4px; }
  p { color: var(--parchment-dim); margin: .6rem 0 0; }
  p:empty { display: none; }
</style>
